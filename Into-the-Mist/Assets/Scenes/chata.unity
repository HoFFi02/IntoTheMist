MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 551518180}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b8d1b08bf0e6c84ba65676127ad789c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 296719761}
  dialogueText: {fileID: 1697912060}
  dialogue:
  - Mmm, Chase. What brings you here?
  - Long time no see, huh?
  - Exactly, I missed you. Your son and I became friends.
  - 'Interesting. Anyways.. Obviously I came for him. '
  - Do you remember what you did to me? Now I will have my vengeance.
  - Yes, I remember that. So.. What do you want?
  - I want to see you suffer while I will be devouring your son. I want to take away
    from you the person who you love the most.
  - Oh, what if I want to break him out from here and take home?
  - You will be devoured also.
  - Okay, you know what.. Let's make a deal. You give me a riddle or a challenge.
  - 'If I manage to solve or do it, you let us go. If not, well.. I think that''s
    obvious.. '
  - 'Let me think.. '
  - Agree. You have 50 seconds.
  gameSceneName: Memory2
  contButton: {fileID: 0}
  wordSpeed: 0.06
  playerIsClose: 0
